APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Dhaka

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Bangladesh Standard Time (UTC+6)
DB_TIMEZONE=+06:00

# Use redis for session and cache. If Redis is not running, set both back to database.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

BLOCK_LIST_API_URL=https://block.mousumibd.org/api
BLOCK_LIST_API_TOKEN=

HRM_API_URL=
HRM_API_TOKEN=

SUPERADMIN_DELETE_PIN=


# Fine & Penalty Management
BKASH_FINE_PAYMENT_NUMBER=01712345678
BKASH_PAYMENT_TYPE=Payment
BKASH_ACCOUNT_NAME="মৌসুমী প্রধান কার্যালয় (MisLoan)"
HR_CONTACT_NAME="এইচ আর ও প্রশাসন বিভাগ"
HR_CONTACT_PHONE="01700000000"
HR_CONTACT_WHATSAPP="8801700000000"
HR_SUPPORT_HOURS="সকাল ৯:০০ - সন্ধ্যা ৬:০০ (শনিবার - বৃহস্পতিবার)"
FINE_DEFAULT_SELF_CORRECTION_FEE=100

# NID OCR (Gemini Vision)
GEMINI_API_KEY=
GEMINI_OCR_MODEL=gemini-3.8-flash

# External Python NID OCR Microservice
NID_OCR_URL=http://127.0.0.1:8001
NID_OCR_TOKEN=
NID_OCR_TIMEOUT=30
