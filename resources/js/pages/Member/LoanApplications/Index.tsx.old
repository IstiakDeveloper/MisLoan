import AdminLayout from '@/layouts/admin-layout';
import { Head, Link } from '@inertiajs/react';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
import { Button } from '@/components/ui/button';
import { Badge } from '@/components/ui/badge';
import { Tabs, TabsContent, TabsList, TabsTrigger } from '@/components/ui/tabs';
import {
    Banknote,
    Calendar,
    Percent,
    ArrowRight,
    CheckCircle2,
    Clock,
    XCircle,
    AlertCircle
} from 'lucide-react';

interface LoanProduct {
    id: number;
    product_name: string;
    product_name_bn: string;
    product_code: string;
    description: string;
    description_bn: string;
    installment_type: 'weekly' | 'monthly';
    duration_months: number;
    number_of_installments: number;
    min_amount: number;
    max_amount: number;
    interest_rate: number;
    service_charge: number;
    interest_calculation_type: string;
    gender_restriction: string;
    min_age: number;
    max_age: number;
    requires_guarantor: boolean;
    number_of_guarantors: number;
}

interface LoanCategory {
    id: number;
    category_name: string;
    category_name_bn: string;
    category_code: string;
    description: string;
    description_bn: string;
    target_group: string;
    active_products: LoanProduct[];
}

interface LoanApplication {
    id: number;
    application_no: string;
    status: string;
    requested_amount: number;
    loan_product: LoanProduct;
    created_at: string;
}

interface Props {
    categories: LoanCategory[];
    applications: {
        data: LoanApplication[];
        current_page: number;
        last_page: number;
    };
}

const statusConfig = {
    draft: { label: 'খসড়া', color: 'bg-gray-100 text-gray-800', icon: AlertCircle },
    submitted: { label: 'জমা হয়েছে', color: 'bg-blue-100 text-blue-800', icon: Clock },
    under_review: { label: 'পর্যালোচনা', color: 'bg-yellow-100 text-yellow-800', icon: Clock },
    approved: { label: 'অনুমোদিত', color: 'bg-green-100 text-green-800', icon: CheckCircle2 },
    rejected: { label: 'প্রত্যাখ্যাত', color: 'bg-red-100 text-red-800', icon: XCircle },
    disbursed: { label: 'বিতরণ হয়েছে', color: 'bg-emerald-100 text-emerald-800', icon: CheckCircle2 },
    cancelled: { label: 'বাতিল', color: 'bg-gray-100 text-gray-800', icon: XCircle },
};

export default function Index({ categories, applications }: Props) {
    const formatAmount = (amount: number) => {
        return new Intl.NumberFormat('bn-BD', {
            style: 'currency',
            currency: 'BDT',
            minimumFractionDigits: 0,
        }).format(amount);
    };

    const weeklyProducts = categories.flatMap(cat =>
        cat.active_products.filter(p => p.installment_type === 'weekly' && p.max_amount >= 100000)
    );

    return (
        <AdminLayout>
            <Head title="ঋণ আবেদন" />

            <div className="py-6">
                <div className="mx-auto max-w-7xl sm:px-6 lg:px-8">
                    <Tabs defaultValue="weekly" className="space-y-6">
                        <TabsList className="grid w-full grid-cols-2">
                            <TabsTrigger value="weekly">সাপ্তাহিক ঋণ (Weekly Loans)</TabsTrigger>
                            <TabsTrigger value="applications">আমার আবেদন (My Applications)</TabsTrigger>
                        </TabsList>

                        <TabsContent value="weekly" className="space-y-6">
                            <div className="bg-white rounded-lg shadow-sm border p-6">
                                <h3 className="text-lg font-semibold mb-4">সাপ্তাহিক কিস্তির ঋণ পণ্য (Weekly Installment Loans)</h3>
                                <p className="text-sm text-gray-600 mb-6">১ লক্ষ টাকা পর্যন্ত ঋণের জন্য আবেদন করুন</p>

                                <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                                    {weeklyProducts.map((product) => (
                                        <Card key={product.id} className="hover:shadow-lg transition-shadow">
                                            <CardHeader>
                                                <div className="flex items-start justify-between">
                                                    <div className="flex-1">
                                                        <CardTitle className="text-base">{product.product_name}</CardTitle>
                                                        <CardDescription className="text-sm mt-1">
                                                            {product.product_name_bn}
                                                        </CardDescription>
                                                    </div>
                                                    <Badge variant="secondary" className="ml-2">
                                                        {product.product_code}
                                                    </Badge>
                                                </div>
                                            </CardHeader>
                                            <CardContent className="space-y-4">
                                                <div className="space-y-2 text-sm">
                                                    <div className="flex items-center justify-between">
                                                        <span className="text-gray-600 flex items-center gap-2">
                                                            <Banknote className="w-4 h-4" />
                                                            ঋণের পরিমাণ:
                                                        </span>
                                                        <span className="font-semibold">
                                                            {formatAmount(product.min_amount)} - {formatAmount(product.max_amount)}
                                                        </span>
                                                    </div>
                                                    <div className="flex items-center justify-between">
                                                        <span className="text-gray-600 flex items-center gap-2">
                                                            <Percent className="w-4 h-4" />
                                                            সুদের হার:
                                                        </span>
                                                        <span className="font-semibold">{product.interest_rate}%</span>
                                                    </div>
                                                    <div className="flex items-center justify-between">
                                                        <span className="text-gray-600 flex items-center gap-2">
                                                            <Calendar className="w-4 h-4" />
                                                            কিস্তি সংখ্যা:
                                                        </span>
                                                        <span className="font-semibold">{product.number_of_installments} টি</span>
                                                    </div>
                                                    <div className="flex items-center justify-between">
                                                        <span className="text-gray-600">মেয়াদ:</span>
                                                        <span className="font-semibold">{product.duration_months} মাস</span>
                                                    </div>
                                                    {product.requires_guarantor && (
                                                        <div className="flex items-center justify-between">
                                                            <span className="text-gray-600">জামিনদার:</span>
                                                            <span className="font-semibold">{product.number_of_guarantors} জন</span>
                                                        </div>
                                                    )}
                                                </div>

                                                <div className="pt-4 border-t">
                                                    <Link
                                                        href={route('member.loan-applications.create', product.id)}
                                                        className="w-full"
                                                    >
                                                        <Button className="w-full bg-primary hover:bg-primary/90">
                                                            আবেদন করুন
                                                            <ArrowRight className="w-4 h-4 ml-2" />
                                                        </Button>
                                                    </Link>
                                                </div>
                                            </CardContent>
                                        </Card>
                                    ))}
                                </div>

                                {weeklyProducts.length === 0 && (
                                    <div className="text-center py-12 text-gray-500">
                                        <Banknote className="w-12 h-12 mx-auto mb-4 text-gray-400" />
                                        <p>কোন সাপ্তাহিক ঋণ পণ্য পাওয়া যায়নি</p>
                                    </div>
                                )}
                            </div>
                        </TabsContent>

                        <TabsContent value="applications" className="space-y-6">
                            <div className="bg-white rounded-lg shadow-sm border">
                                <div className="p-6">
                                    <h3 className="text-lg font-semibold mb-4">আমার ঋণ আবেদন (My Loan Applications)</h3>

                                    {applications.data.length > 0 ? (
                                        <div className="space-y-4">
                                            {applications.data.map((app) => {
                                                const StatusIcon = statusConfig[app.status as keyof typeof statusConfig]?.icon || AlertCircle;
                                                const statusInfo = statusConfig[app.status as keyof typeof statusConfig];

                                                return (
                                                    <Card key={app.id} className="hover:shadow-md transition-shadow">
                                                        <CardContent className="p-6">
                                                            <div className="flex items-start justify-between">
                                                                <div className="flex-1">
                                                                    <div className="flex items-center gap-3 mb-2">
                                                                        <h4 className="font-semibold">{app.loan_product?.product_name}</h4>
                                                                        <Badge className={statusInfo?.color}>
                                                                            <StatusIcon className="w-3 h-3 mr-1" />
                                                                            {statusInfo?.label}
                                                                        </Badge>
                                                                    </div>
                                                                    <p className="text-sm text-gray-600 mb-3">
                                                                        আবেদন নং: {app.application_no}
                                                                    </p>
                                                                    <div className="grid grid-cols-2 gap-4 text-sm">
                                                                        <div>
                                                                            <span className="text-gray-600">ঋণের পরিমাণ:</span>
                                                                            <p className="font-semibold">{formatAmount(app.requested_amount)}</p>
                                                                        </div>
                                                                        <div>
                                                                            <span className="text-gray-600">আবেদনের তারিখ:</span>
                                                                            <p className="font-semibold">
                                                                                {new Date(app.created_at).toLocaleDateString('bn-BD')}
                                                                            </p>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div>
                                                                    <Link href={route('member.loan-applications.show', app.id)}>
                                                                        <Button variant="outline" size="sm">
                                                                            বিস্তারিত দেখুন
                                                                            <ArrowRight className="w-4 h-4 ml-2" />
                                                                        </Button>
                                                                    </Link>
                                                                </div>
                                                            </div>
                                                        </CardContent>
                                                    </Card>
                                                );
                                            })}
                                        </div>
                                    ) : (
                                        <div className="text-center py-12 text-gray-500">
                                            <Banknote className="w-12 h-12 mx-auto mb-4 text-gray-400" />
                                            <p>আপনার কোন ঋণ আবেদন নেই</p>
                                            <p className="text-sm mt-2">উপরের "সাপ্তাহিক ঋণ" ট্যাব থেকে আবেদন করুন</p>
                                        </div>
                                    )}
                                </div>
                            </div>
                        </TabsContent>
                    </Tabs>
                </div>
            </div>
        </AdminLayout>
    );
}
